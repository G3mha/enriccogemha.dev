---
/**
 * The certification badges, shared by the homepage and the About page so a
 * renewal or a new credential is edited in one place. Each page wraps it in
 * its own section and heading.
 *
 * Hovering a badge or its verify link, or focusing the link, opens a card with
 * what the exam covers, as the issuer's own guide lists it. That isn't on the
 * verification page, so the card is readable by screen readers and the link
 * points at it with aria-describedby.
 */
import PreviewCard from './PreviewCard.astro';
import { localeOf } from '../i18n';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui[locale].certs;

// Each links to the issuer's own verification page. Dates are as shown there.
// exam, level and covers come from the issuer's exam guide for the version
// that was live on the date earned. source names that guide, around the exam
// code: whose it is, then what it's called. The names, exam codes and
// verifiers stay in English; the rest is written in every language.
const certifications = [
	{
		name: 'AWS Certified Cloud Practitioner',
		badge: '/assets/badge-aws-cloud-practitioner.png',
		width: 340,
		height: 340,
		verify: 'https://www.credly.com/badges/93f53b4d-ed60-47e9-abdd-bc266ec1bf42/public_url',
		verifier: 'Credly',
		id: 'aws-cloud-practitioner',
		exam: 'CLF-C02',
		// docs.aws.amazon.com/aws-certification/latest/cloud-practitioner-02/cloud-practitioner-02.html.
		// CLF-C02 replaced CLF-C01 on Sep 19, 2023, with these weights since.
		text: {
			en: {
				dates: 'Earned Aug 2025, valid until Aug 2028',
				level: 'Foundational',
				covers: [
					['Cloud Concepts', '24%'],
					['Security and Compliance', '30%'],
					['Cloud Technology and Services', '34%'],
					['Billing, Pricing, and Support', '12%'],
				],
				source: ['AWS’s', 'exam guide'],
			},
			'pt-BR': {
				dates: 'Obtida em ago. 2025, válida até ago. 2028',
				level: 'Fundamental',
				covers: [
					['Conceitos de nuvem', '24%'],
					['Segurança e conformidade', '30%'],
					['Tecnologia e serviços de nuvem', '34%'],
					['Cobrança, preços e suporte', '12%'],
				],
				source: ['da AWS', 'do guia do exame'],
			},
			'es-ES': {
				dates: 'Obtenida en ago. de 2025, válida hasta ago. de 2028',
				level: 'Básico',
				covers: [
					['Conceptos de la nube', '24%'],
					['Seguridad y conformidad', '30%'],
					['Tecnología y servicios de la nube', '34%'],
					['Facturación, precios y soporte', '12%'],
				],
				source: ['de AWS', 'de la guía del examen'],
			},
			sv: {
				dates: 'Tagen aug. 2025, giltig till aug. 2028',
				level: 'Grundläggande',
				covers: [
					['Molnkoncept', '24%'],
					['Säkerhet och efterlevnad', '30%'],
					['Molnteknik och molntjänster', '34%'],
					['Fakturering, priser och support', '12%'],
				],
				source: ['AWS:s', 'provguide'],
			},
		},
	},
	{
		name: 'GitHub Foundations',
		badge: '/assets/badge-github-foundations.svg',
		width: 348,
		height: 349,
		verify: 'https://learn.microsoft.com/en-us/users/enriccogemha-8257/credentials/141fe52eb223f209',
		verifier: 'Microsoft Learn',
		id: 'github-foundations',
		exam: 'GH-900',
		// learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/gh-900,
		// "skills at a glance as of January 2026".
		text: {
			en: {
				dates: 'Earned Aug 2026, valid until Sep 2028',
				level: 'Beginner',
				covers: [
					['Understand Git and GitHub basics', '25–30%'],
					['Work with GitHub repositories', '10–15%'],
					['Collaborate using GitHub', '10–15%'],
					['Apply modern development practices', '10–15%'],
					['Manage projects with GitHub', '5–10%'],
					['Understand privacy, security, and administration', '10–15%'],
					['Explore the GitHub community', '5–10%'],
				],
				source: ['Microsoft Learn’s', 'study guide'],
			},
			'pt-BR': {
				dates: 'Obtida em ago. 2026, válida até set. 2028',
				level: 'Iniciante',
				covers: [
					['Entender o básico de Git e GitHub', '25–30%'],
					['Trabalhar com repositórios no GitHub', '10–15%'],
					['Colaborar usando o GitHub', '10–15%'],
					['Aplicar práticas modernas de desenvolvimento', '10–15%'],
					['Gerenciar projetos com o GitHub', '5–10%'],
					['Entender privacidade, segurança e administração', '10–15%'],
					['Explorar a comunidade do GitHub', '5–10%'],
				],
				source: ['do Microsoft Learn', 'do guia de estudo'],
			},
			'es-ES': {
				dates: 'Obtenida en ago. de 2026, válida hasta sept. de 2028',
				level: 'Principiante',
				covers: [
					['Entender los fundamentos de Git y GitHub', '25–30%'],
					['Trabajar con repositorios de GitHub', '10–15%'],
					['Colaborar con GitHub', '10–15%'],
					['Aplicar prácticas de desarrollo modernas', '10–15%'],
					['Gestionar proyectos con GitHub', '5–10%'],
					['Entender la privacidad, la seguridad y la administración', '10–15%'],
					['Explorar la comunidad de GitHub', '5–10%'],
				],
				source: ['de Microsoft Learn', 'de la guía de estudio'],
			},
			sv: {
				dates: 'Tagen aug. 2026, giltig till sep. 2028',
				level: 'Nybörjare',
				covers: [
					['Förstå grunderna i Git och GitHub', '25–30%'],
					['Arbeta med GitHub-repositorier', '10–15%'],
					['Samarbeta med GitHub', '10–15%'],
					['Tillämpa moderna utvecklingsmetoder', '10–15%'],
					['Hantera projekt med GitHub', '5–10%'],
					['Förstå integritet, säkerhet och administration', '10–15%'],
					['Utforska GitHub-communityn', '5–10%'],
				],
				source: ['Microsoft Learns', 'studieguide'],
			},
		},
	},
].map((cert) => ({ ...cert, ...cert.text[locale] }));
---

<ul class="certs">
	{
		certifications.map((cert) => (
			<li>
				{/* The badge is a second way to click through for the mouse. Keyboard
				    and screen-reader users get the one text link below instead. */}
				<a class="cert-badge" href={cert.verify} rel="noopener" tabindex="-1" aria-hidden="true" data-preview={`cert-${cert.id}`}>
					<img src={cert.badge} alt="" width={cert.width} height={cert.height} loading="lazy" decoding="async" />
				</a>
				<div class="cert-text">
					<span class="cert-name">{cert.name}</span>
					<span class="cert-dates">{cert.dates}</span>
					<a href={cert.verify} rel="noopener" data-preview={`cert-${cert.id}`} aria-describedby={`preview-cert-${cert.id}`}>{t.verifyOn} {cert.verifier}</a>
				</div>
			</li>
		))
	}
</ul>

{
	certifications.map((cert) => (
		<PreviewCard name={`cert-${cert.id}`} wide readable>
			<p class="card-title">{cert.name}</p>
			<p class="card-meta">
				<span class="nowrap">{cert.exam}</span>
				<span>{cert.level}</span>
			</p>
			<ul class="card-covers">
				{cert.covers.map(([domain, weight]) => (
					<li>
						<span>{domain}</span>
						<span class="weight">{weight}</span>
					</li>
				))}
			</ul>
			<p class="card-source">{t.domainsFrom(cert.source[0]!, cert.exam, cert.source[1]!)}</p>
		</PreviewCard>
	))
}

<style>
	/* Each badge sits on white in both themes: AWS asks for its badges to be
	   shown unaltered on white or very light backgrounds, and the GitHub
	   badge's dark shield reads best there too. */
	.certs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.certs li {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.cert-badge {
		flex: none;
		display: block;
		padding: 0.5rem;
		background: #ffffff;
		border: 1px solid var(--rule);
	}

	.cert-badge img {
		width: 5.5rem;
		height: auto;
	}

	.cert-text {
		display: grid;
		gap: 0.15rem;
		font-size: var(--text-base);
	}

	.cert-name {
		font-weight: 600;
		color: var(--ink);
	}

	.cert-dates {
		color: var(--ink-tertiary);
	}

	.card-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 40;
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--ink);
	}

	.card-meta {
		display: flex;
		gap: 0.75rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.card-covers {
		display: grid;
		gap: 0.2rem;
		margin: 0.6rem 0 0;
		padding: 0.6rem 0 0;
		border-top: 1px solid var(--rule);
		list-style: none;
		font-size: var(--text-sm);
	}

	.card-covers li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.weight {
		flex: none;
		font-variant-numeric: tabular-nums;
		color: var(--ink-tertiary);
	}

	.card-source {
		margin-top: 0.6rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}
</style>
