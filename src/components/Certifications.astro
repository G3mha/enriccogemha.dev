---
/**
 * The certification badges, shared by the homepage and the About page so a
 * renewal or a new credential is edited in one place. Each page wraps it in
 * its own section and heading.
 *
 * Hovering a badge or its verify link, or focusing the link, opens a card with
 * what the exam covers, as the issuer's own guide lists it. That isn't on the
 * verification page, so the card is readable by screen readers and the link
 * points at it with aria-describedby.
 */
import PreviewCard from './PreviewCard.astro';

// Each links to the issuer's own verification page. Dates are as shown there.
// exam, level and covers come from the issuer's exam guide for the version
// that was live on the date earned. source names that guide, around the exam
// code: whose it is, then what it's called.
const certifications = [
	{
		name: 'AWS Certified Cloud Practitioner',
		badge: '/assets/badge-aws-cloud-practitioner.png',
		width: 340,
		height: 340,
		dates: 'Earned Aug 2025, valid until Aug 2028',
		verify: 'https://www.credly.com/badges/93f53b4d-ed60-47e9-abdd-bc266ec1bf42/public_url',
		verifier: 'Credly',
		id: 'aws-cloud-practitioner',
		exam: 'CLF-C02',
		level: 'Foundational',
		// docs.aws.amazon.com/aws-certification/latest/cloud-practitioner-02/cloud-practitioner-02.html.
		// CLF-C02 replaced CLF-C01 on Sep 19, 2023, with these weights since.
		covers: [
			['Cloud Concepts', '24%'],
			['Security and Compliance', '30%'],
			['Cloud Technology and Services', '34%'],
			['Billing, Pricing, and Support', '12%'],
		],
		source: ['AWS’s', 'exam guide'],
	},
	{
		name: 'GitHub Foundations',
		badge: '/assets/badge-github-foundations.svg',
		width: 348,
		height: 349,
		dates: 'Earned Aug 2026, valid until Sep 2028',
		verify: 'https://learn.microsoft.com/en-us/users/enriccogemha-8257/credentials/141fe52eb223f209',
		verifier: 'Microsoft Learn',
		id: 'github-foundations',
		exam: 'GH-900',
		level: 'Beginner',
		// learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/gh-900,
		// "skills at a glance as of January 2026".
		covers: [
			['Understand Git and GitHub basics', '25–30%'],
			['Work with GitHub repositories', '10–15%'],
			['Collaborate using GitHub', '10–15%'],
			['Apply modern development practices', '10–15%'],
			['Manage projects with GitHub', '5–10%'],
			['Understand privacy, security, and administration', '10–15%'],
			['Explore the GitHub community', '5–10%'],
		],
		source: ['Microsoft Learn’s', 'study guide'],
	},
];
---

<ul class="certs">
	{
		certifications.map((cert) => (
			<li>
				{/* The badge is a second way to click through for the mouse. Keyboard
				    and screen-reader users get the one text link below instead. */}
				<a class="cert-badge" href={cert.verify} rel="noopener" tabindex="-1" aria-hidden="true" data-preview={`cert-${cert.id}`}>
					<img src={cert.badge} alt="" width={cert.width} height={cert.height} loading="lazy" decoding="async" />
				</a>
				<div class="cert-text">
					<span class="cert-name">{cert.name}</span>
					<span class="cert-dates">{cert.dates}</span>
					<a href={cert.verify} rel="noopener" data-preview={`cert-${cert.id}`} aria-describedby={`preview-cert-${cert.id}`}>Verify on {cert.verifier}</a>
				</div>
			</li>
		))
	}
</ul>

{
	certifications.map((cert) => (
		<PreviewCard name={`cert-${cert.id}`} wide readable>
			<p class="card-title">{cert.name}</p>
			<p class="card-meta">
				<span class="nowrap">{cert.exam}</span>
				<span>{cert.level}</span>
			</p>
			<ul class="card-covers">
				{cert.covers.map(([domain, weight]) => (
					<li>
						<span>{domain}</span>
						<span class="weight">{weight}</span>
					</li>
				))}
			</ul>
			<p class="card-source">Exam domains from {cert.source[0]} <span class="nowrap">{cert.exam}</span> {cert.source[1]}.</p>
		</PreviewCard>
	))
}

<style>
	/* Each badge sits on white in both themes: AWS asks for its badges to be
	   shown unaltered on white or very light backgrounds, and the GitHub
	   badge's dark shield reads best there too. */
	.certs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.certs li {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.cert-badge {
		flex: none;
		display: block;
		padding: 0.5rem;
		background: #ffffff;
		border: 1px solid var(--rule);
	}

	.cert-badge img {
		width: 5.5rem;
		height: auto;
	}

	.cert-text {
		display: grid;
		gap: 0.15rem;
		font-size: var(--text-base);
	}

	.cert-name {
		font-weight: 600;
		color: var(--ink);
	}

	.cert-dates {
		color: var(--ink-tertiary);
	}

	.card-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 40;
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--ink);
	}

	.card-meta {
		display: flex;
		gap: 0.75rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.card-covers {
		display: grid;
		gap: 0.2rem;
		margin: 0.6rem 0 0;
		padding: 0.6rem 0 0;
		border-top: 1px solid var(--rule);
		list-style: none;
		font-size: var(--text-sm);
	}

	.card-covers li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.weight {
		flex: none;
		font-variant-numeric: tabular-nums;
		color: var(--ink-tertiary);
	}

	.card-source {
		margin-top: 0.6rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}
</style>