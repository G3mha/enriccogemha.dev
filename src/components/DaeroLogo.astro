---
/**
 * DAERO's wordmark, as served at daerogroup.com/brand/daero.svg: five paths,
 * refilled with currentColor so it takes the link colour in either theme. The
 * letters fill the full 20-unit height, so the whole mark is cap height and
 * sits on the baseline. Link styles come from .inline-mark in global.css.
 *
 * No whitespace between the anchor and the SVG, or after them, so no stray
 * space renders inside the link or before the comma that follows it.
 *
 * href points the mark somewhere other than daerogroup.com, such as the
 * ZeroPunch project page. preview names the project whose card the link opens
 * on hover or focus (see ProjectPreviews).
 */
interface Props {
	href?: string;
	preview?: string;
}

const { href = 'https://www.daerogroup.com/', preview } = Astro.props;
const rel = href.startsWith('http') ? 'noopener' : undefined;
---

<style>
	.daero {
		height: 0.72em;
		vertical-align: 0;
	}
</style>

<a class="inline-mark" href={href} rel={rel} data-preview={preview}><svg
	class="daero"
	viewBox="0 0 114 20"
	role="img"
	aria-label="DAERO"
	fill="currentColor"
	xmlns="http://www.w3.org/2000/svg"
>
