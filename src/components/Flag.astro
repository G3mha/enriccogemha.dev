---
/**
 * National flags for places named in running text, drawn here at their
 * official proportions in the same colours as lipis/flag-icons (the set the
 * Flags app uses).
 *
 * Thailand and France are plain stripes. Brazil follows the construction in
 * Lei 5.700: a 20 x 14 field, the rhombus 1.7 units from the edges, a disc of
 * radius 3.5, and a white band between arcs of radius 8 and 8.5 centred two
 * units left of where the disc's vertical diameter meets the bottom edge. Its
 * 27 stars and motto are left out: at text size they'd be under a pixel.
 * Sweden follows its flag law: a 16 x 10 field with a cross two units wide,
 * the vertical bar five units from the hoist. Spain follows its constitution:
 * red, yellow and red stripes, the yellow twice as tall as each red, on a
 * 3 x 2 field. This is the civil flag, without the coat of arms, which Spanish
 * law allows and which at text size would be a smudge. The United States
 * follows Executive Order 10834: a 1.9 x 1 field of thirteen stripes, the
 * union 7/13 of the hoist tall and 0.76 of it wide. Its 50 stars are left out
 * for the same reason as Brazil's.
 *
 * Pass decorative when the country is already named in the text beside the
 * flag, so screen readers don't read the name twice.
 *
 * Sized to the height of lining figures, so a flag sits level with the year
 * beside it. The hairline outline keeps white stripes visible on light paper.
 */
interface Props {
	country: 'th' | 'fr' | 'br' | 'se' | 'es' | 'us';
	/** Place name, used as the accessible name and hover tooltip. */
	label?: string;
	/** Hide from screen readers; use when the text already names the country. */
	decorative?: boolean;
}

const { country, label = '', decorative = false } = Astro.props;
const a11y = decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label };
---

<style>
	.flag {
		display: inline-block;
		height: 0.72em;
		width: auto;
		vertical-align: 0;
		outline: 1px solid var(--rule-strong);
	}
</style>

{
	country === 'th' ? (
		<svg class="flag" viewBox="0 0 9 6" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="9" height="6" fill="#a51931" /><rect y="1" width="9" height="4" fill="#f4f5f8" /><rect y="2" width="9" height="2" fill="#2d2a4a" /></svg>
	) : country === 'fr' ? (
		<svg class="flag" viewBox="0 0 3 2" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="3" height="2" fill="#fff" /><rect width="1" height="2" fill="#000091" /><rect x="2" width="1" height="2" fill="#e1000f" /></svg>
	) : country === 'us' ? (
		<svg class="flag" viewBox="0 0 247 130" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="247" height="130" fill="#bd3d44" /><path d="M0 15h247M0 35h247M0 55h247M0 75h247M0 95h247M0 115h247" stroke="#fff" stroke-width="10" /><rect width="98.8" height="70" fill="#192f5d" /></svg>
	) : country === 'es' ? (
		<svg class="flag" viewBox="0 0 12 8" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="12" height="8" fill="#aa151b" /><rect y="2" width="12" height="4" fill="#f1bf00" /></svg>
	) : country === 'se' ? (
		<svg class="flag" viewBox="0 0 16 10" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="16" height="10" fill="#005293" /><rect x="5" width="2" height="10" fill="#fecb00" /><rect y="4" width="16" height="2" fill="#fecb00" /></svg>
	) : (
		<svg class="flag" viewBox="0 0 20 14" {...a11y} xmlns="http://www.w3.org/2000/svg">{!decorative && <title>{label}</title>}<rect width="20" height="14" fill="#309e3a" /><path d="M10 1.7 18.3 7 10 12.3 1.7 7Z" fill="#f8e509" /><circle cx="10" cy="7" r="3.5" fill="#2b49a3" /><path d="M6.612 6.121A8 8 0 0 1 13.341 8.044A3.5 3.5 0 0 0 13.466 7.490A8.5 8.5 0 0 0 6.799 5.585A3.5 3.5 0 0 0 6.612 6.121Z" fill="#fff" /></svg>
	)
}