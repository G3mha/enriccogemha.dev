---
const year = new Date().getFullYear();
---

<footer>
	<div class="wrapper">
		<p>&copy; {year} Enricco Gemha</p>
		<ul>
			<li><a href="https://github.com/G3mha" rel="me noopener">GitHub</a></li>
			<li><a href="https://www.linkedin.com/in/enriccogemha" rel="me noopener">LinkedIn</a></li>
			<li><a href="mailto:me@enriccogemha.dev">me@enriccogemha.dev</a></li>
			<li><a href="/privacy/">Privacy</a></li>
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		padding-block: 2rem;
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.wrapper {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--ink-tertiary);
		text-decoration: none;
	}

	a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
