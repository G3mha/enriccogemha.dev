---
/**
 * The language switch in the header: the current language's flag on a button
 * that opens a short list, one link per language, each to this same page in
 * that language. It's a <details>, so it opens and closes without JavaScript.
 * The script only closes it on a click elsewhere, on Esc, or when keyboard
 * focus leaves it, the way a menu is expected to behave.
 *
 * English gets the US flag, since that's where the site's author lives and
 * the spelling the site uses; Portuguese the Brazilian one, Spanish the
 * Spanish one and Swedish the Swedish one. Flag.astro draws them all.
 */
import Flag from './Flag.astro';
import { locales, localeOf, localePath, stripLocale, type Locale } from '../i18n';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
const page = stripLocale(Astro.url.pathname);
const flags: Record<Locale, 'us' | 'br' | 'es' | 'se'> = { en: 'us', 'pt-BR': 'br', 'es-ES': 'es', sv: 'se' };
---

<details class="language">
	<summary aria-label={t.language.current} title={t.language.label}>
		<Flag country={flags[locale]} decorative />
		<svg class="chevron" aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3.5 5 6.5 8 3.5" /></svg>
	</summary>
	<ul class="menu" aria-label={t.language.label}>
		{
			locales.map((l) => (
				<li>
					<a href={localePath(l, page)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
						<Flag country={flags[l]} decorative />
						<span>{ui[l].languageName}</span>
					</a>
				</li>
			))
		}
	</ul>
</details>

<style>
	.language {
		position: relative;
	}

	/* Built like the theme toggle beside it: the same height, border and
	   surface, so the two read as one row of controls. */
	summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.25rem;
		padding: 0 0.55rem 0 0.6rem;
		border: 1px solid var(--rule-strong);
		background: var(--surface);
		color: var(--ink-secondary);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover,
	.language[open] summary {
		color: var(--accent);
		border-color: var(--accent);
	}

	.language :global(.flag) {
		height: 0.95rem;
	}

	.chevron {
		display: block;
		transition: transform 0.15s ease;
	}

	.language[open] .chevron {
		transform: rotate(180deg);
	}

	/* The list hangs under the button, aligned to its right edge so it stays
	   inside the page, and sits above the content like a preview card. */
	.menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 10;
		min-width: 12rem;
		margin: 0;
		padding: 0.3rem;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--rule-strong);
		box-shadow: 0 4px 12px rgb(27 25 23 / 0.08);
	}

	.menu a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.7rem;
		font-size: var(--text-base);
		color: var(--ink-secondary);
		text-decoration: none;
		white-space: nowrap;
	}

	.menu a:hover {
		background: var(--surface-sunk);
		color: var(--ink);
	}

	/* The page's own language is marked with weight and the accent rule, like
	   the current page in the main nav, so it reads without colour. */
	.menu a[aria-current] {
		color: var(--ink);
		font-weight: 600;
	}

	.menu a[aria-current] span {
		border-bottom: 1px solid var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.chevron {
			transition: none;
		}
	}
</style>

<script>
	for (const details of document.querySelectorAll<HTMLDetailsElement>('details.language')) {
		const summary = details.querySelector('summary');
		document.addEventListener('click', (event) => {
			if (details.open && !details.contains(event.target as Node)) details.open = false;
		});
		details.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !details.open) return;
			details.open = false;
			summary?.focus();
		});
		// Tabbing out of the open list closes it, like a click outside does.
		details.addEventListener('focusout', (event) => {
			const next = event.relatedTarget as Node | null;
			if (details.open && next && !details.contains(next)) details.open = false;
		});
	}
</script>
