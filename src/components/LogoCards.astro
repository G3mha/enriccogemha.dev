---
/**
 * Preview cards for the schools, games and companies named in the text: the
 * owner's logo, the name, where and when, and a line on what it's known for.
 * The facts and their sources are in src/data/cards.ts. Pass the keys of the
 * cards the page links to, and give each link the matching data-preview.
 */
import PreviewCard from './PreviewCard.astro';
import { cards } from '../data/cards';

interface Props {
	ids: string[];
}

const { ids } = Astro.props;
const items = ids.map((key) => {
	const card = cards[key];
	if (!card) throw new Error(`No preview card named ${key}`);
	return { key, ...card };
});
---

{
	items.map((item) => (
		<PreviewCard name={item.key}>
			<span class:list={['card-logo', item.logo.chip]}><img src={item.logo.src} alt="" width={item.logo.width} height={item.logo.height} decoding="async" /></span>
			<p class="card-title">{item.name}</p>
			<p class="card-meta">
				<span>{item.place}</span>
				<span>{item.year}</span>
			</p>
			<p class="card-about">{item.about}</p>
		</PreviewCard>
	))
}

<style>
	/* Laid out like the certification cards. */
	.card-logo {
		display: inline-flex;
		margin-bottom: 0.6rem;
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--rule);
		background: #ffffff;
	}

	.card-logo.dark {
		background: #0c0f11;
	}

	.card-logo img {
		height: 2rem;
		width: auto;
		max-width: 11rem;
		object-fit: contain;
	}

	.card-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 40;
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--ink);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.1rem 0.75rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.card-about {
		margin-top: 0.6rem;
	}
</style>
