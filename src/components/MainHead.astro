---
// Fraunces (with its optical-size axis, for headings) and Public Sans, served
// from this site. Imported before global.css so its tokens can name them.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource-variable/public-sans/wght-italic.css';
import '../styles/global.css';
// The two files every page needs for its first screen. Preloading them starts
// the downloads before the stylesheet is parsed, so on most connections the
// text is set in its real fonts before the first paint and nothing swaps.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import ogCardEn from '../assets/og-card.jpg';
import ogCardPtBR from '../assets/og-card.pt-BR.jpg';
import { locales, localeOf, localePath, ogLocale, stripLocale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
const { title = t.siteName } = Astro.props;

// Pages without their own description, like the homepage, get two. Search
// results show the long one. Chat previews get their own, which leaves out
// what I build because the card above it already says that. WhatsApp's docs
// say 80 characters is enough there, and phones cut off longer lines, so this
// one stays close to that.
const description = Astro.props.description ?? t.description.search;
const previewDescription = Astro.props.description ?? t.description.preview;

const origin = Astro.site ?? 'https://enriccogemha.dev';
const canonical = new URL(Astro.url.pathname, origin);
// The same page in each language, for search engines. The English one is
// also the default, for readers whose language the site doesn't have.
const page = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({ lang: l, href: new URL(localePath(l, page), origin) }));

// The card chat apps show when a link to any page is shared, in the page's
// language. scripts/og-card.mjs draws both. Facebook caches the image by its
// URL, so they're imported rather than kept in public/: the build names each
// file after a hash of its contents, and a redrawn card gets a new URL.
// Stating the size lets Facebook's crawler show it on the first share instead
// of after it has downloaded and processed it.
const ogCard = locale === 'pt-BR' ? ogCardPtBR : ogCardEn;
const card = {
	src: new URL(ogCard.src, canonical),
	width: ogCard.width,
	height: ogCard.height,
	alt: t.description.cardAlt,
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
<link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />

<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={t.siteName} />
<meta property="og:locale" content={ogLocale[locale]} />
{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={previewDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={card.src} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={card.width} />
<meta property="og:image:height" content={card.height} />
<meta property="og:image:alt" content={card.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={card.alt} />

{/* ?lang=pt_BR (or en) on any address goes to that language's copy of the
    page. On Vercel the redirects in vercel.json do this before the page is
    sent; this is for astro dev and any host without them, and runs before
    anything is painted. */}
<script is:inline>
	(() => {
		const params = new URLSearchParams(location.search);
		const asked = params.get('lang');
		if (!asked) return;
		const want = /^pt([_-]br)?$/i.test(asked) ? 'pt-BR' : /^en([_-]us)?$/i.test(asked) ? 'en' : null;
		if (!want) return;
		const path = location.pathname;
		const inPt = path === '/pt-BR' || path.startsWith('/pt-BR/');
		const page = inPt ? path.slice('/pt-BR'.length) || '/' : path;
		const target = (want === 'pt-BR' ? '/pt-BR' : '') + page;
		if (target === path) return;
		params.delete('lang');
		const query = params.toString();
		location.replace(target + (query ? `?${query}` : '') + location.hash);
	})();
</script>

{/* Set the theme before first paint so the page never flashes the wrong one. */}
<script is:inline>
	(() => {
		try {
			const saved = localStorage.getItem('theme');
			if (saved === 'light' || saved === 'dark') {
				document.documentElement.dataset.theme = saved;
			}
		} catch {
			/* Private mode and blocked site data both land here. Fall back to the system theme. */
		}
	})();
</script>
