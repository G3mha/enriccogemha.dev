---
// Fraunces (with its optical-size axis, for headings) and Public Sans, served
// from this site. Imported before global.css so its tokens can name them.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource-variable/public-sans/wght-italic.css';
import '../styles/global.css';
// The two files every page needs for its first screen. Preloading them starts
// the downloads before the stylesheet is parsed, so on most connections the
// text is set in its real fonts before the first paint and nothing swaps.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title = 'Enricco Gemha' } = Astro.props;

// Pages without their own description, like the homepage, get two. Search
// results show the long one. Chat previews get a shorter one, because WhatsApp
// shows about 80 characters and the card above it already says what I build.
const description =
	Astro.props.description ??
	'I build iOS apps. I’m a master’s student at Brown, and before that I was the first engineering hire at DAERO, a construction software startup in Boston.';
const previewDescription =
	Astro.props.description ?? 'I’m doing a master’s at Brown. Before that I was DAERO’s first engineering hire.';

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://enriccogemha.dev');

// The card chat apps show when a link to any page is shared. scripts/og-card.mjs
// draws it. Stating its size lets Facebook's crawler show it on the first share
// instead of after it has downloaded and processed the image.
const card = {
	src: new URL('/og-card.jpg', canonical),
	width: 1200,
	height: 630,
	alt: 'The name Enricco Gemha and the headline “I build iOS apps.” beside a photo of Enricco smiling in a navy suit.',
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Enricco Gemha" />
<meta property="og:title" content={title} />
<meta property="og:description" content={previewDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={card.src} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={card.width} />
<meta property="og:image:height" content={card.height} />
<meta property="og:image:alt" content={card.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={card.alt} />

{/* Set the theme before first paint so the page never flashes the wrong one. */}
<script is:inline>
	(() => {
		try {
			const saved = localStorage.getItem('theme');
			if (saved === 'light' || saved === 'dark') {
				document.documentElement.dataset.theme = saved;
			}
		} catch {
			/* Private mode and blocked site data both land here. Fall back to the system theme. */
		}
	})();
</script>
