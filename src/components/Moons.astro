---
/**
 * Seven hidden Moons, a nod to the Power Moons in Super Mario Odyssey. Each
 * is earned by poking around the site, and a counter shows up in the footer
 * once the first one is found. The Moon is Nintendo's own Power Moon art,
 * served unmodified from supermario.nintendo.com/assets/img/explore/moon.svg
 * as public/assets/power-moon.svg. It belongs to Nintendo. Moons not found yet
 * show it faded, like the see-through Moons the game leaves once collected.
 * Finding one dims the screen while the Moon jumps up in the middle under the
 * game's line, "You got a Moon!". In the game Mario poses with the Moon; here
 * the Moon takes his place.
 *
 * Every trigger listens to something the site already does, so no other
 * component knows about the Moons: the theme attribute on <html>, the toggle
 * event preview cards fire when they open (and clicks on their links, since
 * phones open the link instead of the card), the headline's typed text,
 * clicks on the capstone PDF, and two markers, data-moon-lost on the 404 page
 * and data-project on each project page.
 *
 * Progress, and whether the visitor turned the chime off, is kept in
 * localStorage under "moons" from the first visit and never leaves the browser (see the privacy page, which also has a button to
 * clear it). The school and game lists come from src/data/cards.ts, so every
 * card there has to be linked from some page or its Moon can't be earned.
 */
import { getCollection } from 'astro:content';
import { cards } from '../data/cards';

const work = await getCollection('work');
const projects = work.map((p) => p.id).sort();
const pdf = work.find((p) => p.id === 'pinpag-capstone')?.data.links.find((l) => l.href.endsWith('.pdf'))?.href;
if (!pdf) throw new Error('Moons: the capstone page has no PDF link for the Redacted Moon');
const schools = Object.keys(cards).filter((k) => k.startsWith('school-')).map((k) => k.slice('school-'.length));
const games = Object.keys(cards).filter((k) => k.startsWith('game-')).map((k) => k.slice('game-'.length));
if (games.length !== 2) throw new Error('Moons: the Game Night hint says "both games"; update it for a different count');

const moons = [
	{ id: 'night-owl', name: 'Night Owl', hint: 'Switch between light and dark in the header.' },
	{ id: 'every-phrase', name: 'Every Phrase', hint: 'Watch the homepage headline type every ending.', calm: 'Spend half a minute with the homepage headline.' },
	{ id: 'scholar', name: 'Scholar', hint: `Look up all ${schools.length} schools on the About page.` },
	{ id: 'game-night', name: 'Game Night', hint: 'Look up both games on the About page.' },
	{ id: 'redacted', name: 'Redacted', hint: 'Read the capstone report.' },
	{ id: 'lost-kingdom', name: 'Lost Kingdom', hint: 'Wander somewhere that doesn’t exist.' },
	{ id: 'grand-tour', name: 'Grand Tour', hint: `Visit all ${projects.length} project pages.` },
];

const moonArt = { src: '/assets/power-moon.svg', width: 170, height: 168 };
---

<span
	class="moons"
	data-moons={JSON.stringify(moons.map(({ id, name }) => ({ id, name })))}
	data-projects={JSON.stringify(projects)}
	data-schools={JSON.stringify(schools)}
	data-games={JSON.stringify(games)}
	data-pdf={pdf}
>
	<button type="button" class="moon-count" popovertarget="moons-panel" aria-haspopup="dialog" hidden>
		<img class="moon-icon" src={moonArt.src} width={moonArt.width} height={moonArt.height} alt="" decoding="async" />
		<span data-count></span>
	</button>
</span>

<div id="moons-panel" class="moons-panel" popover role="dialog" aria-labelledby="moons-title" tabindex="-1" autofocus>
	<p id="moons-title" class="panel-title">Moons</p>
	<ul class="moon-list">
		{
			moons.map((moon) => (
				<li data-moon={moon.id}>
					<img class="moon-icon" src={moonArt.src} width={moonArt.width} height={moonArt.height} alt="" decoding="async" />
					<span class="moon-name">
						{moon.name} <span class="moon-state" data-state></span>
					</span>
					<span class="moon-hint" data-hint={moon.hint} data-calm={moon.calm}>{moon.hint}</span>
				</li>
			))
		}
	</ul>
	<div class="panel-actions">
		<button type="button" class="panel-button" data-forget>Forget my Moons</button>
		<button type="button" class="panel-button" data-sound>Turn sound off</button>
		<button type="button" class="panel-button" popovertarget="moons-panel" popovertargetaction="hide">Close</button>
	</div>
</div>

<p class="sr-only" role="status" data-announce></p>
<div class="moon-get" popover="manual" aria-hidden="true">
	<img class="get-moon" src={moonArt.src} width={moonArt.width} height={moonArt.height} alt="" decoding="async" />
	<p class="get-title">You got a Moon!</p>
	<p class="get-name" data-get-name></p>
</div>
<div class="moon-toast" popover="manual" aria-hidden="true"></div>

<script>
	(() => {
		const root = document.querySelector<HTMLElement>('.moons');
		if (!root) return;
		const moons: { id: string; name: string }[] = JSON.parse(root.dataset.moons!);
		const lists: Record<string, string[]> = {
			projects: JSON.parse(root.dataset.projects!),
			schools: JSON.parse(root.dataset.schools!),
			games: JSON.parse(root.dataset.games!),
			phrases: [],
		};
		const pdf = root.dataset.pdf;
		const counter = root.querySelector<HTMLButtonElement>('.moon-count')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const panel = document.getElementById('moons-panel')!;
		const soundButton = panel.querySelector<HTMLButtonElement>('[data-sound]')!;
		const toast = document.querySelector<HTMLElement>('.moon-toast')!;
		const moment = document.querySelector<HTMLElement>('.moon-get')!;
		const momentName = moment.querySelector<HTMLElement>('[data-get-name]')!;
		const status = document.querySelector<HTMLElement>('[data-announce]')!;
		const calm = matchMedia('(prefers-reduced-motion: reduce)');

		// State: what's found, and progress towards the Moons that need a set.
		// Anything else in storage (old ids, wrong types) is dropped on read.
		const KEY = 'moons';
		const ids = new Set(moons.map((m) => m.id));
		const strings = (v: unknown) => (Array.isArray(v) ? [...new Set(v.filter((x): x is string => typeof x === 'string'))] : []);
		type State = { found: string[]; seen: Record<string, string[]>; muted: boolean };
		const empty = (): State => ({ found: [], seen: {}, muted: false });
		let stored = true;
		const load = (): State => {
			let saved: any = {};
			try {
				saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {};
			} catch (error) {
				if (error instanceof DOMException) stored = false;
			}
			const seen = saved.seen && typeof saved.seen === 'object' && !Array.isArray(saved.seen) ? saved.seen : {};
			return {
				found: strings(saved.found).filter((id) => ids.has(id)),
				seen: Object.fromEntries(Object.keys(lists).map((b) => [b, strings(seen[b])])),
				muted: saved.muted === true,
			};
		};
		let state = load();
		// Re-read before each change, so two tabs don't overwrite each other.
		const refresh = () => {
			if (stored) state = load();
		};
		const save = () => {
			try {
				localStorage.setItem(KEY, JSON.stringify(state));
			} catch {
				/* Without storage the Moons still count for this page view. */
			}
		};

		const forget = () => {
			state = empty();
			try {
				localStorage.removeItem(KEY);
			} catch {
				/* Nothing saved to remove. */
			}
		};

		// Announcements go to a visually hidden status line, and what's on screen
		// is hidden from screen readers so they don't hear it twice. Both visible
		// pieces are top-layer popovers, so they show above an open preview card.
		// Anything that happens while the page loads waits for it to settle, so
		// screen readers hear it.
		const settled = (show: () => void) => {
			if (document.readyState === 'complete') show();
			else addEventListener('load', () => setTimeout(show, 750), { once: true });
		};

		let statusTimer: number | undefined;
		const announce = (text: string) => {
			status.textContent = text;
			clearTimeout(statusTimer);
			statusTimer = window.setTimeout(() => (status.textContent = ''), 4000);
		};

		let toastTimer: number | undefined;
		const note = (lead: string, rest: string) =>
			settled(() => {
				announce(`${lead} ${rest}`);
				const strong = document.createElement('strong');
				strong.textContent = lead;
				toast.replaceChildren(strong, ` ${rest}`);
				if (toast.matches(':popover-open')) toast.hidePopover();
				toast.showPopover();
				clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => {
					toast.hidePopover();
					toast.replaceChildren();
				}, 4000);
			});

		// The chime is written for this site, not taken from the game: a quick
		// rising C major arpeggio, then a ringing chord, under two seconds. It's
		// built from oscillators, so there's no file to load, and iPhones mute it
		// with the silent switch. Browsers only allow sound after a click, tap or
		// key press on the page (hovering doesn't count), so the audio starts on
		// the first one. It rests between chimes; once a browser has let it start,
		// it lets it wake again without another click.
		let audio: AudioContext | undefined;
		let voice: GainNode | undefined;
		let restTimer: number | undefined;
		let busyUntil = 0;
		const rest = (after: number) => {
			clearTimeout(restTimer);
			const wait = Math.max(after, busyUntil - performance.now());
			restTimer = window.setTimeout(() => audio?.suspend().catch(() => {}), wait);
		};
		const wakeAudio = () => {
			if (state.muted || state.found.length === moons.length) return;
			try {
				audio ??= new AudioContext();
			} catch {
				return;
			}
			if (audio.state === 'suspended') audio.resume().catch(() => {});
			rest(1000);
		};
		const chime = (ctx: AudioContext) => {
			const start = ctx.currentTime + 0.03;
			const out = ctx.createGain();
			out.gain.value = 0.14;
			out.connect(ctx.destination);
			voice = out;
			const tone = (hz: number, at: number, length: number, type: OscillatorType, level: number) => {
				const osc = ctx.createOscillator();
				const env = ctx.createGain();
				osc.type = type;
				osc.frequency.value = hz;
				env.gain.setValueAtTime(0.0001, at);
				env.gain.exponentialRampToValueAtTime(level, at + 0.012);
				env.gain.exponentialRampToValueAtTime(0.0001, at + length);
				osc.connect(env).connect(out);
				osc.start(at);
				osc.stop(at + length + 0.05);
			};
			// C5 E5 G5 C6, 70 ms apart, then G5 C6 E6 ringing with a soft C7 on top.
			[523.25, 659.25, 783.99, 1046.5].forEach((hz, i) => tone(hz, start + i * 0.07, 0.28, 'triangle', 1));
			for (const hz of [783.99, 1046.5, 1318.51]) tone(hz, start + 0.3, 1.5, 'sine', 0.5);
			tone(2093, start + 0.3, 0.9, 'sine', 0.12);
			busyUntil = performance.now() + 2000;
		};
		// Each chime belongs to its own moment: only the newest moment chimes,
		// once, within a second of opening, in a tab that's showing, while it's
		// still on screen. If the browser holds the sound back longer than that
		// (no click or key press yet), the chime is dropped rather than played
		// late, and held chimes from earlier Moons can't pile up and play at once.
		let chimeFor = 0;
		const playChime = () => {
			const id = ++chimeFor;
			if (state.muted) return;
			try {
				audio ??= new AudioContext();
			} catch {
				return;
			}
			const ctx = audio;
			const asked = performance.now();
			const go = () => {
				const current = id === chimeFor && performance.now() - asked < 1000 && !document.hidden && !state.muted;
				const showing = moment.matches(':popover-open') && !moment.classList.contains('leaving');
				if (ctx.state === 'running' && current && showing) chime(ctx);
				rest(0);
			};
			if (ctx.state === 'running') go();
			else ctx.resume().then(go, () => {});
		};

		// The Moon-get moment. It never takes focus and lets clicks through, and
		// any click or Esc ends it early. Otherwise it fades after three seconds,
		// so with the fade it's gone well inside the five seconds WCAG allows for
		// motion nobody asked for.
		let momentTimer: number | undefined;
		const leave = () => {
			if (!moment.matches(':popover-open') || moment.classList.contains('leaving')) return;
			clearTimeout(momentTimer);
			moment.classList.add('leaving');
			momentTimer = window.setTimeout(() => {
				moment.hidePopover();
				moment.classList.remove('leaving');
			}, 350);
		};
		const celebrate = (rest: string) =>
			settled(() => {
				announce(`You got a Moon! ${rest}`);
				momentName.textContent = rest;
				clearTimeout(momentTimer);
				moment.classList.remove('leaving');
				// Reading a layout value between hide and show makes the browser apply
				// the hidden state, so the Moon jumps again for a second Moon in a row.
				if (moment.matches(':popover-open')) {
					moment.hidePopover();
					void moment.offsetWidth;
				}
				moment.showPopover();
				playChime();
				momentTimer = window.setTimeout(leave, 3000);
			});

		const forgetButtons = document.querySelectorAll<HTMLButtonElement>('[data-forget]');
		const supported = 'showPopover' in HTMLElement.prototype;

		for (const button of forgetButtons) {
			button.addEventListener('click', () => {
				const fromPanel = panel.contains(button);
				forget();
				if (supported) {
					render();
					if (panel.matches(':popover-open')) panel.hidePopover();
					if (fromPanel) document.querySelector<HTMLElement>('footer a[href="/privacy/"]')?.focus();
					note('Your Moons are forgotten.', 'Progress starts again from zero.');
				} else {
					button.textContent = 'Forgotten';
				}
			});
		}

		// Without the popover API the list and note can't open, so the Moons stay
		// hidden (the privacy page's Forget button still works).
		if (!supported) return;

		const render = () => {
			const n = state.found.length;
			counter.hidden = n === 0;
			count.textContent = `${n} of ${moons.length} Moons`;
			for (const li of panel.querySelectorAll<HTMLElement>('[data-moon]')) {
				const found = state.found.includes(li.dataset.moon!);
				li.classList.toggle('found', found);
				const label = li.querySelector<HTMLElement>('[data-state]')!;
				label.textContent = found ? 'Found' : 'Not found yet';
				label.classList.toggle('sr-only', !found);
				const hint = li.querySelector<HTMLElement>('[data-hint]')!;
				hint.textContent = calm.matches && hint.dataset.calm ? hint.dataset.calm : hint.dataset.hint!;
			}
			soundButton.textContent = state.muted ? 'Turn sound on' : 'Turn sound off';
		};

		soundButton.addEventListener('click', () => {
			refresh();
			state.muted = !state.muted;
			save();
			render();
			// Cut a chime that's still ringing. Pausing it would leave the rest
			// scheduled, and it would play on the next click.
			if (state.muted) {
				voice?.disconnect();
				voice = undefined;
				audio?.suspend().catch(() => {});
			}
		});

		const stops: Record<string, () => void> = {};
		const award = (id: string) => {
			refresh();
			if (state.found.includes(id)) return;
			state.found.push(id);
			save();
			render();
			stops[id]?.();
			const n = state.found.length;
			const name = moons.find((m) => m.id === id)!.name;
			celebrate(n === moons.length ? `${name}. That’s all ${n}.` : `${name}. ${n} of ${moons.length}.`);
		};

		// Collect items towards a Moon that needs all of them, across visits.
		const collect = (bucket: string, item: string, id: string) => {
			refresh();
			const seen = new Set(state.seen[bucket]);
			if (!seen.has(item)) {
				seen.add(item);
				state.seen[bucket] = [...seen];
				save();
			}
			if (lists[bucket].length && lists[bucket].every((x) => seen.has(x))) award(id);
		};
		const has = (id: string) => state.found.includes(id);

		render();
		addEventListener('storage', (event) => {
			if (event.key !== KEY && event.key !== null) return;
			state = load();
			render();
		});
		addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			state = load();
			render();
		});

		addEventListener('keydown', (event) => {
			if (event.key === 'Escape') leave();
		});
		addEventListener('pointerdown', leave, true);

		// The presses browsers count as permission to play sound: a mouse button
		// going down, a finger or pen lifting, or a key other than Esc or a bare
		// modifier.
		addEventListener('pointerdown', (event) => event.pointerType === 'mouse' && wakeAudio(), true);
		addEventListener('pointerup', (event) => event.pointerType !== 'mouse' && wakeAudio(), true);
		const notActivation = new Set(['Escape', 'Shift', 'Control', 'Alt', 'Meta', 'CapsLock']);
		addEventListener('keydown', (event) => !notActivation.has(event.key) && wakeAudio(), true);

		// Keyboard users who tab out of the open list close it, like a click
		// outside does.
		panel.addEventListener('focusout', (event) => {
			const next = event.relatedTarget as Node | null;
			if (next && !panel.contains(next)) panel.hidePopover();
		});

		// Night Owl: the theme toggle sets data-theme on <html>. The saved theme is
		// applied in <head> before this runs, so only a toggle counts.
		if (!has('night-owl')) {
			const observer = new MutationObserver(() => award('night-owl'));
			observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			stops['night-owl'] = () => observer.disconnect();
		}

		// Scholar and Game Night: preview cards are popovers, and their toggle
		// event doesn't bubble, so listen in the capture phase.
		document.addEventListener(
			'toggle',
			(event) => {
				const target = event.target as HTMLElement;
				if ((event as ToggleEvent).newState !== 'open' || !target.id) return;
				if (target.id.startsWith('preview-school-')) collect('schools', target.id.slice('preview-school-'.length), 'scholar');
				if (target.id.startsWith('preview-game-')) collect('games', target.id.slice('preview-game-'.length), 'game-night');
			},
			true,
		);

		// Redacted, and the phone path for Scholar and Game Night: a tap on a
		// school or game name follows the link instead of opening the card.
		// Middle-clicks count too; right-clicks don't.
		const onClick = (event: MouseEvent) => {
			if (event.type === 'auxclick' && event.button !== 1) return;
			const link = (event.target as Element).closest?.('a');
			if (!link) return;
			if (pdf && link.getAttribute('href') === pdf) award('redacted');
			const key = link.dataset.preview;
			if (key?.startsWith('school-')) collect('schools', key.slice('school-'.length), 'scholar');
			if (key?.startsWith('game-')) collect('games', key.slice('game-'.length), 'game-night');
		};
		document.addEventListener('click', onClick, true);
		document.addEventListener('auxclick', onClick, true);

		// Lost Kingdom and Grand Tour: markers on the 404 page and project pages.
		if (document.querySelector('[data-moon-lost]')) award('lost-kingdom');
		const project = document.querySelector<HTMLElement>('[data-project]');
		if (project) collect('projects', project.dataset.project!, 'grand-tour');

		// Every Phrase: count each ending once it has been typed out in full. With
		// reduced motion the headline doesn't type, so half a minute with it on
		// screen counts instead.
		const line = document.querySelector<HTMLElement>('.build-line');
		if (line && !has('every-phrase')) {
			lists.phrases = JSON.parse(line.dataset.phrases!);
			// The headline also holds hidden copies of every phrase for measuring,
			// so read the one inside .words, the line people actually see.
			const typed = line.querySelector('.words .typed');
			let dwell: number | undefined;
			let view: IntersectionObserver | undefined;
			const watchView = () => {
				if (view) return;
				view = new IntersectionObserver((entries) => {
					clearTimeout(dwell);
					if (entries[entries.length - 1].isIntersecting) dwell = window.setTimeout(() => award('every-phrase'), 30000);
				});
				view.observe(line);
			};
			let typing: MutationObserver | undefined;
			if (calm.matches) watchView();
			else if (typed) {
				const check = () => {
					const text = typed.textContent ?? '';
					if (text.endsWith('.') && lists.phrases.includes(text.slice(0, -1))) collect('phrases', text.slice(0, -1), 'every-phrase');
				};
				check();
				typing = new MutationObserver(check);
				typing.observe(typed, { childList: true, characterData: true, subtree: true });
			}
			calm.addEventListener('change', () => {
				render();
				if (calm.matches) watchView();
			});
			stops['every-phrase'] = () => {
				typing?.disconnect();
				view?.disconnect();
				clearTimeout(dwell);
			};
		}
	})();
</script>

<style>
	.moon-icon {
		width: auto;
		height: 1.15em;
		flex: none;
	}

	.moon-count {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		font-weight: 600;
		color: var(--ink-tertiary);
		cursor: pointer;
	}

	/* The text sets the button's baseline, so it lines up with the copyright
	   line. Without this the image would, and its baseline is its bottom edge. */
	.moon-count [data-count] {
		align-self: baseline;
	}

	.moon-count:hover {
		color: var(--accent);
	}

	.moon-count[hidden] {
		display: none;
	}

	/* Hidden unless open, so browsers without the popover API never show it.
	   The site's reset zeroes margins, which would pin it to the top left; auto
	   margins put it back in the middle, and max-height keeps it on screen. */
	.moons-panel {
		display: none;
		inset: 0;
		margin: auto;
		height: fit-content;
		max-height: calc(100% - 2rem);
		width: min(24rem, calc(100% - 2rem));
		padding: 1.25rem;
		border: 1px solid var(--rule-strong);
		background: var(--surface);
		color: var(--ink);
	}

	.moons-panel:popover-open {
		display: block;
	}

	.moons-panel:focus {
		outline: none;
	}

	.moons-panel::backdrop {
		background: rgb(0 0 0 / 0.25);
	}

	.panel-title {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-lg);
	}

	.moon-list {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.moon-list li {
		display: grid;
		grid-template-columns: 1.4rem 1fr;
		gap: 0 0.6rem;
		align-items: baseline;
	}

	/* Not found yet: a faded grey Moon, like the game's see-through replicas. */
	.moon-list .moon-icon {
		grid-row: span 2;
		align-self: center;
		height: 1.3rem;
		filter: grayscale(1);
		opacity: 0.35;
	}

	.moon-list .found .moon-icon {
		filter: none;
		opacity: 1;
	}

	.moon-name {
		font-weight: 600;
