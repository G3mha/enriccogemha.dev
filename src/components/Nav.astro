---
import ThemeToggle from './ThemeToggle.astro';
import LanguageMenu from './LanguageMenu.astro';
import NameWordmark from './NameWordmark.astro';
import { localeOf, localePath, stripLocale } from '../i18n';
import { ui } from '../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
// The page's path without its language prefix, so /pt-BR/about/ is About too.
const path = stripLocale(Astro.url.pathname);
const links = [
	{ page: '/', label: t.nav.work },
	{ page: '/about/', label: t.nav.about },
];

const isCurrent = (page: string) =>
	page === '/' ? path === '/' : path.startsWith(page);
---

<header>
	<nav class="wrapper" aria-label="Main">
		<a class="wordmark" href={localePath(locale, '/')}><NameWordmark /></a>

		<ul class="links">
			{
				links.map(({ page, label }) => (
					<li>
						<a href={localePath(locale, page)} aria-current={isCurrent(page) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<a class="external" href="https://github.com/G3mha" aria-label="GitHub" rel="me noopener"><svg class="brand-icon github" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" /></svg><span class="label">GitHub</span></a>
			</li>
			<li>
				<a class="external" href="https://www.linkedin.com/in/enriccogemha" aria-label="LinkedIn" rel="me noopener"><img class="brand-icon linkedin on-light" src="/assets/linkedin-in-black.png" alt="" width="52" height="48" /><img class="brand-icon linkedin on-dark" src="/assets/linkedin-in-white.png" alt="" width="52" height="48" /><span class="label">LinkedIn</span></a>
			</li>
		</ul>

		<div class="controls">
			<LanguageMenu />
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--rule);
		background: var(--paper);
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 1rem;
	}

	/* The name is a drawing of Fraunces italic (see NameWordmark). The drawing
	   is about three quarters of an em tall, so at 1.2rem it reads as 26px
	   text beside the 16px links. */
	.wordmark {
		display: block;
		flex: none;
		color: var(--ink);
		text-decoration: none;
	}

	.wordmark :global(.name-wordmark) {
		display: block;
		height: 1.2rem;
		width: auto;
	}

	.wordmark:hover {
		color: var(--accent);
	}

	/* The language menu and the theme toggle, one row at the end of the nav. */
	.controls {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin-left: auto;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
		align-items: center;
	}

	/* Every link is built the same way, icon or not, so they share a centre line. */
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: var(--ink-secondary);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1px solid transparent;
	}

	/* Brand marks before GitHub and LinkedIn. Both are decorative, since the
	   link text names the site.

	   LinkedIn's rules allow its [in] logo only in blue, black or white and
	   forbid recolouring it, so these use LinkedIn's own black and white files,
	   swapped by theme, and don't take the hover colour. GitHub's mark (from
	   GitHub's Octicons) gets the same black and white so the pair matches. */
	.brand-icon {
		flex: none;
		width: auto;
	}

	.brand-icon.github {
		height: 1em;
		color: #000;
	}

	.brand-icon.linkedin {
		height: 0.9em;
	}

	.on-dark {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .brand-icon.github {
			color: #fff;
		}
		:global(:root:not([data-theme='light'])) .on-light {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .on-dark {
			display: block;
		}
	}

	:global(:root[data-theme='dark']) .brand-icon.github {
		color: #fff;
	}

	:global(:root[data-theme='dark']) .on-light {
		display: none;
	}

	:global(:root[data-theme='dark']) .on-dark {
		display: block;
	}

	.links a:hover {
		color: var(--accent);
	}

	/* The current page is marked with a rule rather than a colour alone,
	   so it survives for readers who cannot distinguish the accent. */
	.links a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}

	/* Below 39em the name, four links and the two controls no longer fit on
	   one line, and letting the links wrap split them unevenly (3 + 1 on a
	   402px iPhone). So the nav becomes two rows on purpose: the name and the
	   controls on top, and the links on a full-width row under them. */
	@media (max-width: 39em) {
		nav {
			flex-wrap: wrap;
			row-gap: 0.5rem;
		}

		.controls {
			margin-left: auto;
		}

		.links {
			order: 1;
			flex-basis: 100%;
			margin-left: 0;
		}
	}

	/* On the narrowest phones even that row is too long with labels, so
	   GitHub and LinkedIn show only their marks. The link keeps its name
	   through aria-label, and the padding keeps each tap target at least
	   24px square. In Portuguese and Spanish, "Projetos"/"Proyectos" and
	   "Sobre"/"Sobre mí" are longer than "Work" and "About", so the same
	   happens up to a 390px phone. Swedish, "Projekt" and "Om mig", fits. */
	@media (max-width: 23em) {
		.external .label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
		}

		.external {
			padding: 0.25rem;
		}

		.brand-icon.github,
		.brand-icon.linkedin {
			height: 1.15em;
		}
	}

	@media (max-width: 26em) {
		:global(html:is([lang='pt-BR'], [lang='es-ES'])) .external .label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
		}

		:global(html:is([lang='pt-BR'], [lang='es-ES'])) .external {
			padding: 0.25rem;
		}

		:global(html:is([lang='pt-BR'], [lang='es-ES'])) .brand-icon.github,
		:global(html:is([lang='pt-BR'], [lang='es-ES'])) .brand-icon.linkedin {
			height: 1.15em;
		}
	}
</style>
