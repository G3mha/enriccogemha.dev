---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Work' },
	{ href: '/about/', label: 'About' },
];

const isCurrent = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<header>
	<nav class="wrapper" aria-label="Main">
		<a class="wordmark" href="/">Enricco&nbsp;Gemha</a>

		<ul class="links">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<a href="https://github.com/G3mha" rel="me noopener">GitHub</a>
			</li>
			<li>
				<a href="mailto:me@enriccogemha.dev">Email</a>
			</li>
		</ul>

		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--rule);
		background: var(--paper);
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 1rem;
	}

	.wordmark {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-lg);
		color: var(--ink);
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.wordmark:hover {
		color: var(--accent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin-left: auto;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}

	.links a {
		color: var(--ink-secondary);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1px solid transparent;
	}

	.links a:hover {
		color: var(--accent);
	}

	/* The current page is marked with a rule rather than a colour alone,
	   so it survives for readers who cannot distinguish the accent. */
	.links a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}
</style>
