---
/**
 * NFX's wordmark, from nfx.com/images/dark/nfx-logo.svg, reduced to its three
 * shapes and filled with currentColor so it takes the link colour in either
 * theme. Sized so the N and X match the cap height of the text around it and
 * sit on its baseline; the f rises above and drops below, like a letter.
 *
 * The anchor and the SVG are written with no whitespace between them or after
 * them, so no stray space renders inside the link or before the next period.
 */
---

<style>
	.nfx-link {
		color: var(--ink);
		text-decoration: none;
	}

	.nfx-link:hover {
		color: var(--accent);
	}

	/* 77 of the 123 units are cap height, and the baseline is at y = 100. */
	.nfx {
		display: inline-block;
		height: 1.15em;
		width: auto;
		vertical-align: -0.215em;
	}
</style>

<a class="nfx-link" href="https://www.nfx.com/" rel="noopener"><svg
	class="nfx"
	viewBox="0 0 201 123"
	role="img"
	aria-label="NFX"
	fill="currentColor"
	xmlns="http://www.w3.org/2000/svg"
>
	<title>NFX</title>
	<polygon points="53.2,23 53.2,32.7 62.6,32.7 62.6,80.5 20.5,23 0,23 0,32.7 9.3,32.7 9.3,90.3 0,90.3 0,100 30.6,100 30.6,90.3 21.2,90.3 21.2,43.2 63.1,100 74.5,100 74.5,32.7 84,32.7 84,23" />
	<polygon points="169,23 169,32.1 177.4,32.1 162.3,52.5 147,32.1 155.3,32.1 155.3,23 124.7,23 124.7,32.7 133.4,32.7 155.2,60.7 132,90.3 123,90.3 123,100 154,100 154,90.8 145.6,90.8 162.3,68.7 179.2,90.8 170.1,90.8 170.1,100 201,100 201,90.3 192.3,90.3 169.3,60.7 191.3,32.7 199.8,32.7 199.8,23" />
	<path transform="translate(69 0)" d="M53,8.6c2.4,0,4.5,0.7,5.5,1.2c1.2-2.6,2.4-5.4,3.5-8C60.3,0.9,56.3,0,52.5,0 C40.3,0,32.6,7.6,30.9,20.3l-4.8,36.2h-8.8l-3.1,9.9h9.3h1.3l-4.9,37.1c-0.9,7.1-4.7,10.9-10.9,10.9c-2.3,0-4.3-0.5-5.7-1.1 c-1.1,2.6-2.1,5.4-3.3,8.1c1.9,0.9,6.2,1.5,9.2,1.5c11.8,0,20-7.1,21.7-20.3l4.8-36.2h8.9l3.1-9.9H37.2l0,0l4.9-37.1 C43,12.5,46.7,8.6,53,8.6" />
</svg></a>