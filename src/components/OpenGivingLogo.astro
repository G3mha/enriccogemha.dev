---
/**
 * OpenGiving's logo in its own colours. OpenGiving ships two official files,
 * a three-blue version for light backgrounds and a white one for dark, and
 * its site swaps them by theme; this does the same, with neither recoloured.
 * The blues can't carry dark mode: the wordmark's #005197 is 7.7:1 on the
 * light paper but 2.3:1 on the dark one. Neither version takes the hover
 * colour, since recolouring the brand is what this avoids.
 *
 * Measured from the artwork: the wordmark's cap height is 36.0% of the mark's
 * height and its baseline sits 38.4% up from the bottom. At 1.6em the icon is
 * about the size of the RoboCup ball further down the intro, and the wordmark
 * sits on the text's baseline at a little under its cap height.
 *
 * href points the logo somewhere other than opengiving.us, such as its project
 * page. preview names the project whose card the link opens on hover or focus
 * (see ProjectPreviews).
 */
interface Props {
	href?: string;
	preview?: string;
}

const { href = 'https://opengiving.us/', preview } = Astro.props;
const rel = href.startsWith('http') ? 'noopener' : undefined;
---

<style>
	.opengiving {
		display: inline-block;
		height: 1.6em;
		width: auto;
		margin-block: 0 -0.2em;
		vertical-align: -0.414em;
	}

	.dark-only {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .light-only {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .dark-only {
			display: inline-block;
		}
	}

	:global(:root[data-theme='dark']) .light-only {
		display: none;
	}

	:global(:root[data-theme='dark']) .dark-only {
		display: inline-block;
	}
</style>

<a class="inline-mark" href={href} rel={rel} data-preview={preview}><img class="opengiving light-only" src="/assets/opengiving-logo-light.svg" alt="OpenGiving" width="985" height="276" decoding="async" /><img class="opengiving dark-only" src="/assets/opengiving-logo-dark.svg" alt="OpenGiving" width="985" height="276" decoding="async" /></a>