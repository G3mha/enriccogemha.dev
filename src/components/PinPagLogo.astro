---
/**
 * PinPag's logo in its own colours. PinPag's site serves two files, the
 * colour logo in its header (pinpag.com.br/assets/images/logo.svg) and a white
 * one in its footer (logo-white.svg); this swaps them by theme, with neither
 * recoloured. The only change to either file is an added viewBox, which both
 * lacked, so that they scale when sized in em.
 *
 * Measured from the artwork: the capital P is 57.1% of the logo's height and
 * its baseline is 57.7% down from the top, with the row of icons below it. At
 * 1.267em the P matches the body text's cap height (0.723em), and the wordmark
 * sits on the text's baseline. The icons hang below it; the negative bottom
 * margin keeps them from making the line taller.
 *
 * large: shown on its own above the capstone's project page.
 * linked={false} drops the pinpag.com.br link, for places where the logo already
 * sits inside another link. decorative sets empty alt text, for places where
 * the word "PinPag" is already written next to it.
 */
interface Props {
	size?: 'inline' | 'large';
	linked?: boolean;
	decorative?: boolean;
}

const { size = 'inline', linked = true, decorative = false } = Astro.props;
const alt = decorative ? '' : 'PinPag';
---

<style>
	.pinpag {
		display: inline-block;
		height: 1.267em;
		width: auto;
		margin-block: 0 -0.1em;
		vertical-align: -0.436em;
	}

	.pinpag.large {
		height: auto;
		width: 11rem;
		margin: 0;
		vertical-align: baseline;
	}

	.dark-only {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .light-only {
			display: none;
		}

		:global(:root:not([data-theme='light'])) .dark-only {
			display: inline-block;
		}
	}

	:global(:root[data-theme='dark']) .light-only {
		display: none;
	}

	:global(:root[data-theme='dark']) .dark-only {
		display: inline-block;
	}
</style>

{
	linked ? (
		<a class="inline-mark" href="https://www.pinpag.com.br/" rel="noopener"><img class:list={['pinpag', size, 'light-only']} src="/assets/pinpag-logo-light.svg" alt={alt} width="1191" height="517" decoding="async" /><img class:list={['pinpag', size, 'dark-only']} src="/assets/pinpag-logo-dark.svg" alt={alt} width="1191" height="517" decoding="async" /></a>
	) : (
		<><img class:list={['pinpag', size, 'light-only']} src="/assets/pinpag-logo-light.svg" alt={alt} width="1191" height="517" decoding="async" /><img class:list={['pinpag', size, 'dark-only']} src="/assets/pinpag-logo-dark.svg" alt={alt} width="1191" height="517" decoding="async" /></>
	)
}