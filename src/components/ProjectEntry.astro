---
import type { CollectionEntry } from 'astro:content';
import Status from './Status.astro';
import Tags from './Tags.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<article class="entry">
	<div class="head">
		<h3><a href={`/work/${id}/`}>{data.title}</a></h3>
		<Status status={data.status} />
	</div>

	<p class="period">{data.period}</p>
	<p class="summary">{data.summary}</p>
	<p class="role">{data.role}</p>

	<Tags items={data.stack} />

	{
		data.links.length > 0 && (
			<ul class="links">
				{data.links.map((link) => (
					<li>
						<a href={link.href} rel="noopener">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-block: 2rem;
		border-top: 1px solid var(--rule);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
	}

	h3 {
		font-size: var(--text-2xl);
		margin: 0;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.period {
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
		margin: -0.3rem 0 0;
	}

	.summary {
		max-width: var(--measure);
		color: var(--ink);
	}

	.role {
		max-width: var(--measure);
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}
</style>
