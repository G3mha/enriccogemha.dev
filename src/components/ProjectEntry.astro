---
import type { CollectionEntry } from 'astro:content';
import Status from './Status.astro';
import Tags from './Tags.astro';
import MarkedText from './MarkedText.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<article class="entry">
	<div class="head">
		{data.icon && <img class="entry-icon" src={data.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />}
		<h3><a href={`/work/${id}/`} data-preview={`${id}-opening`}>{data.title}</a></h3>
		<Status status={data.status} />
	</div>

	<p class="period">{data.period}</p>
	<p class="summary"><MarkedText text={data.summary} logos={data.logos} /></p>
	{data.role && <p class="role">{data.role}</p>}

	<Tags items={data.stack} />

	{
		data.links.length > 0 && (
			<ul class="links">
				{data.links.map((link) => (
					<li>
						<a href={link.href} rel="noopener">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-block: 2rem;
	}

	/* A line between entries, none above the first. */
	.entry + .entry {
		border-top: 1px solid var(--rule);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	/* Same size and shape as the icons in Things you can install. The 31%
	   radius hides the white corners baked into OpenGiving's artwork. */
	.entry-icon {
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--rule);
		border-radius: 31%;
	}

	h3 {
		font-size: var(--text-2xl);
		margin: 0;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent);
	}

	.period {
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
		margin: -0.3rem 0 0;
	}

	.summary {
		max-width: var(--measure);
		color: var(--ink);
	}

	.role {
		max-width: var(--measure);
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}
</style>
