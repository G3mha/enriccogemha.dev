---
interface Props {
	items: string[];
	label?: string;
}

const { items, label = 'Built with' } = Astro.props;
---

<ul class="tags" aria-label={label}>
	{items.map((item) => <li>{item}</li>)}
</ul>

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.5;
		padding: 0.15rem 0.45rem;
		color: var(--ink-tertiary);
		background: var(--surface-sunk);
		border: 1px solid var(--rule);
	}
</style>
