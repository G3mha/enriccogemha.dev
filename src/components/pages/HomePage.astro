---
/**
 * The homepage, in whichever language the URL says. The layout, the lists and
 * their headings are here once; the intro paragraphs come from src/copy/, one
 * file per language, through the `intro` slot.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../ProjectEntry.astro';
import Status from '../Status.astro';
import DaeroLogo from '../DaeroLogo.astro';
import RoboCupLogo from '../RoboCupLogo.astro';
import BuildLine from '../BuildLine.astro';
import PinPagLogo from '../PinPagLogo.astro';
import LuaLogo from '../LuaLogo.astro';
import SwiftLogo from '../SwiftLogo.astro';
import DeepRacerLogo from '../DeepRacerLogo.astro';
import Certifications from '../Certifications.astro';
import ProjectPreviews from '../ProjectPreviews.astro';
import LogoCards from '../LogoCards.astro';
import { getWork } from '../../data/work';
import { localeOf, localePath } from '../../i18n';
import { ui } from '../../i18n/ui';

const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
const projects = await getWork(locale);
const featured = projects.filter((p) => p.data.featured);

// Logos drawn before a name in the Earlier list. Each sits inside the row's
// link, so it drops its own link and alt text.
const listLogos = { robocup: RoboCupLogo, pinpag: PinPagLogo, lua: LuaLogo, swift: SwiftLogo, deepracer: DeepRacerLogo } as const;
const rest = projects.filter((p) => !p.data.featured);

// Each app once, with every store it's on. The name opens the project page,
// and on hover or focus the opening of its write-up (see ProjectPreviews); the
// store links open the listings.
const apps = [
	{
		name: 'OpenGiving',
		id: 'opengiving',
		icon: '/assets/app-icon-opengiving.jpg',
		stores: [
			{ label: 'App Store', href: 'https://apps.apple.com/us/app/opengiving-donate-shop/id6756851957' },
			{ label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=me.opengiving.android' },
		],
	},
	{
		name: 'Trophy Rooms',
		id: 'trophy-rooms',
		icon: '/assets/app-icon-trophy-rooms.jpg',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/trophy-rooms/id6799829599' }],
	},
	{
		name: 'PacBag',
		id: 'pacbag',
		icon: '/assets/app-icon-pacbag.jpg',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/pacbag-digital-luggage/id6749021887' }],
	},
	{
		name: 'ZeroPunch',
		id: 'zeropunch',
		icon: '/assets/app-icon-zeropunch.jpg',
		mark: 'daero',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/id6753096907' }],
	},
] as const;

const work = (id: string) => localePath(locale, `/work/${id}/`);
---

<BaseLayout>
	<div class="wrapper stack gap-16 lg:gap-24">
		<header class="intro">
			<div class="intro-text">
				<BuildLine />
				<slot name="intro" />
			</div>
			<img
				src="/assets/demoing-opengiving.jpg"
				alt={t.home.photoAlt}
				width="630"
				height="1110"
				decoding="async"
				fetchpriority="high"
			/>
		</header>
		<ProjectPreviews ids={['opengiving', 'zeropunch', 'pinpag-capstone', 'robocup']} openings={projects.map((p) => p.id)} />
		<LogoCards ids={['school-brown', 'school-harvard', 'school-insper', 'org-nfx']} />

		<section class="stack gap-4" aria-labelledby="shipped-heading">
			<h2 class="section-label" id="shipped-heading">{t.home.install}</h2>
			<ul class="apps">
				{
					apps.map((app) => (
						<li>
							<img class="app-icon" src={app.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
							<div class="app-text">
								<a class="app-name" href={work(app.id)} data-preview={`${app.id}-opening`}>{app.name}</a>
								<span class="app-about">{t.home.apps[app.id]}{'mark' in app && app.mark === 'daero' && <> <DaeroLogo />.</>}</span>
							</div>
							<ul class="stores">
								{app.stores.map((store) => (
									<li>
										<a href={store.href} rel="noopener">{store.label}<span class="sr-only">: {app.name}</span></a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack gap-4" aria-labelledby="certifications-heading">
			<h2 class="section-label" id="certifications-heading">{t.home.certifications}</h2>
			<Certifications />
		</section>

		<section class="stack" aria-labelledby="work-heading">
			<h2 class="section-label" id="work-heading">{t.home.work}</h2>
			{featured.map((project) => <ProjectEntry project={project} />)}
		</section>

		<section class="stack gap-4" aria-labelledby="more-heading">
			<h2 class="section-label" id="more-heading">{t.home.earlier}</h2>
			<ul class="compact">
				{
					rest.map((project) => (
						<li>
							<a href={work(project.id)} data-preview={`${project.id}-opening`}>{project.data.icon && <><img class="compact-icon" src={project.data.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />{' '}</>}{project.data.logos.map((l) => listLogos[l as keyof typeof listLogos]).filter(Boolean).map((Logo) => <><Logo linked={false} decorative />{' '}</>)}{project.data.logoOnly ? <span class="sr-only">{project.data.title}</span> : <span class="compact-name">{project.data.title}</span>}</a>
							<span class="compact-summary">{project.data.summary}</span>
							<span class="compact-meta">
								<span>{project.data.period}</span>
								<Status status={project.data.status} />
							</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.intro {
		display: grid;
		gap: 2rem;
	}

	.intro-text {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: var(--measure);
	}

	.intro-text :global(.build-line) {
		margin-bottom: 0.4rem;
	}

	/* The paragraphs come through the slot, so their classes are global here. */
	.intro-text :global(.contact) {
		font-size: var(--text-base);
		margin-top: 0.4rem;
	}

	/* On narrow screens the photo sits above the greeting at avatar size,
	   so the first thing on the page is still a face and a name. */
	.intro img {
		order: -1;
		width: 7.5rem;
		border: 1px solid var(--rule);
	}

	@media (min-width: 48em) {
		.intro {
			grid-template-columns: minmax(0, 1fr) 13rem;
			gap: 3.5rem;
			align-items: start;
		}

		.intro img {
			order: 0;
			width: 100%;
			margin-top: 0.75rem;
		}
	}

	/* One row per app, divided like the Earlier list below it. On wide screens
	   the store links sit at the end of the row; on narrow ones they drop under
	   the description. */
	.apps {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.apps > li {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		align-items: start;
		gap: 0.35rem 1rem;
		padding-block: 0.9rem;
	}

	.apps > li + li {
		border-top: 1px solid var(--rule);
	}

	/* OpenGiving's artwork has its own rounded corners with white outside
	   them, starting 31% in from each corner. Masking every icon at 31%
	   hides that white and gives the three the same shape. */
	.app-icon {
		grid-row: span 2;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--rule);
		border-radius: 31%;
	}

	.app-text {
		display: grid;
		gap: 0.1rem;
	}

	.app-name {
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.app-name:hover {
		color: var(--accent);
	}

	.app-about {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.stores {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}

	@media (min-width: 42em) {
		.apps > li {
			grid-template-columns: 2.75rem minmax(0, 1fr) auto;
			align-items: center;
		}

		.app-icon {
			grid-row: auto;
		}

		.stores {
			justify-content: flex-end;
		}
	}

	.compact {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.compact li {
		display: grid;
		gap: 0.15rem 1rem;
		padding-block: 0.9rem;
	}

	.compact li + li {
		border-top: 1px solid var(--rule);
	}

	/* App projects show their icon before the name, the same shape as the
	   icons above but sized to the line like the logos in this list. */
	.compact-icon {
		display: inline-block;
		width: 1.6em;
		height: 1.6em;
		vertical-align: middle;
		margin-block: -0.3em;
		border: 1px solid var(--rule);
		border-radius: 31%;
	}

	.compact-summary {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.compact-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	@media (min-width: 42em) {
		.compact li {
			grid-template-columns: 12rem 1fr auto;
			align-items: baseline;
		}

		.compact-meta {
			justify-content: flex-end;
		}
	}
</style>
