---
/**
 * One 404 page serves every address, in every language: Vercel has a single
 * 404.html, so an unknown /pt-BR/ or /sv/ address lands here too. The English
 * comes first; a line of script puts the address's language first and marks
 * the page as that language when the address starts with its prefix.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { locales } from '../i18n';
import { ui } from '../i18n/ui';

const home: Record<string, string> = {
	en: 'There’s nothing at this address. The <a href="/">work</a> is on the front page.',
	'pt-BR': 'Não há nada neste endereço. Os <a href="/pt-BR/">projetos</a> estão na página inicial.',
	'es-ES': 'No hay nada en esta dirección. Los <a href="/es-ES/">proyectos</a> están en la portada.',
	sv: 'Det finns inget på den här adressen. <a href="/sv/">Projekten</a> finns på startsidan.',
};
const titles = Object.fromEntries(locales.map((l) => [l, ui[l].notFound.title]));
---

<BaseLayout title={ui.en.notFound.title} description={ui.en.notFound.description}>
	<div class="wrapper wrapper-narrow stack gap-10" data-moon-lost data-titles={JSON.stringify(titles)}>
		{
			locales.map((l) => (
				<section class="stack gap-4" lang={l} data-lang={l}>
					<h1>{ui[l].notFound.heading}</h1>
					<p set:html={home[l]} />
				</section>
			))
		}
	</div>
</BaseLayout>

<script is:inline>
	(() => {
		const first = location.pathname.split('/')[1];
		const section = first && document.querySelector(`[data-lang="${first}"]`);
		if (!section) return;
		document.documentElement.lang = first;
		const titles = JSON.parse(section.parentElement.dataset.titles);
		document.title = titles[first];
		section.parentElement.prepend(section);
	})();
</script>
