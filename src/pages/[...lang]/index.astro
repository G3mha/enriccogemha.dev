---
/**
 * The homepage, once per language: / in English and /pt-BR/ in Portuguese.
 * The page itself is in src/copy/<language>/home.astro.
 */
import { localeFromParams, localePaths } from '../../i18n';
import En from '../../copy/en/home.astro';
import PtBR from '../../copy/pt-BR/home.astro';

export const getStaticPaths = localePaths;

const Page = { en: En, 'pt-BR': PtBR }[localeFromParams(Astro.params)];
---

<Page />
