---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Status from '../components/Status.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

const shipped = [
	{
		label: 'OpenGiving',
		note: 'iOS',
		href: 'https://apps.apple.com/us/app/opengiving-donate-shop/id6756851957',
	},
	{
		label: 'OpenGiving',
		note: 'Android',
		href: 'https://play.google.com/store/apps/details?id=me.opengiving.android',
	},
	{
		label: 'PacBag',
		note: 'iOS',
		href: 'https://apps.apple.com/us/app/pacbag-digital-luggage/id6749021887',
	},
	{
		label: 'ZeroPunch',
		note: 'iOS, at DAERO',
		href: 'https://apps.apple.com/us/app/id6753096907',
	},
];
---

<BaseLayout>
	<div class="wrapper stack gap-16 lg:gap-24">
		<header class="intro">
			<div class="intro-text">
				<h1>I build iOS apps and the backends behind them.</h1>
				<p class="lede">
					These days that’s <a href="/work/opengiving/">OpenGiving</a>, a marketplace
					where part of every sale goes to a fundraising campaign. I write all the code
					for it: the web app, the iOS and Android apps, and the API they share.
				</p>
				<p>
					I’m from São Paulo. I’m at Brown until May 2027, doing a master’s in
					entrepreneurship. Before Brown I was the first hire at
					<a href="/work/zeropunch/">DAERO</a>, a Boston startup that makes software for
					construction crews. I spent ten months on their iOS app, and in February 2026
					I started rewriting it from scratch.
				</p>
				<p>
					I got my computer engineering degree at Insper, where I was on a small team
					building rescue robots. Our robots won Best in Class awards at the
					<a href="/work/robocup/">RoboCup</a> world championship in 2022 and 2023.
				</p>
				<p class="contact">
					Email’s the easiest way to reach me:
					<a href="mailto:me@enriccogemha.dev">me@enriccogemha.dev</a>
				</p>
			</div>
			<img
				src="/assets/portrait.jpg"
				alt="Enricco Gemha, in a navy suit, photographed outdoors in front of evergreen trees."
				width="867"
				height="1200"
				decoding="async"
				fetchpriority="high"
			/>
		</header>

		<section class="stack gap-4" aria-labelledby="shipped-heading">
			<h2 class="section-label" id="shipped-heading">Things you can install</h2>
			<ul class="shipped">
				{
					shipped.map((item) => (
						<li>
							<a href={item.href} rel="noopener">
								{item.label}
							</a>
							<span>{item.note}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="work-heading">
			<h2 class="section-label" id="work-heading">Work</h2>
			{featured.map((project) => <ProjectEntry project={project} />)}
		</section>

		<section class="stack gap-4" aria-labelledby="more-heading">
			<h2 class="section-label" id="more-heading">Earlier</h2>
			<ul class="compact">
				{
					rest.map((project) => (
						<li>
							<a href={`/work/${project.id}/`}>{project.data.title}</a>
							<span class="compact-summary">{project.data.summary}</span>
							<span class="compact-meta">
								<span>{project.data.period}</span>
								<Status status={project.data.status} />
							</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.intro {
		display: grid;
		gap: 2rem;
	}

	.intro-text {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: var(--measure);
	}

	.intro-text h1 {
		margin-bottom: 0.4rem;
	}

	.lede {
		font-size: var(--text-lg);
		color: var(--ink);
	}

	.contact {
		font-size: var(--text-base);
		margin-top: 0.4rem;
	}

	/* On narrow screens the photo sits above the greeting at avatar size,
	   so the first thing on the page is still a face and a name. */
	.intro img {
		order: -1;
		width: 7.5rem;
		border: 1px solid var(--rule);
	}

	@media (min-width: 48em) {
		.intro {
			grid-template-columns: minmax(0, 1fr) 13rem;
			gap: 3.5rem;
			align-items: start;
		}

		.intro img {
			order: 0;
			width: 100%;
			margin-top: 0.75rem;
		}
	}

	.shipped {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shipped li {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.shipped span {
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.compact {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.compact li {
		display: grid;
		gap: 0.15rem 1rem;
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
	}

	.compact-summary {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.compact-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	@media (min-width: 42em) {
		.compact li {
			grid-template-columns: 12rem 1fr auto;
			align-items: baseline;
		}

		.compact-meta {
			justify-content: flex-end;
		}
	}
</style>
