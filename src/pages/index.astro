---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Status from '../components/Status.astro';
import NfxLogo from '../components/NfxLogo.astro';
import DaeroLogo from '../components/DaeroLogo.astro';
import OpenGivingLogo from '../components/OpenGivingLogo.astro';
import RoboCupLogo from '../components/RoboCupLogo.astro';
import Flag from '../components/Flag.astro';
import BuildLine from '../components/BuildLine.astro';
import PinPagLogo from '../components/PinPagLogo.astro';
import LuaLogo from '../components/LuaLogo.astro';
import Certifications from '../components/Certifications.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

// Each app once, with every store it's on. The name opens the project page;
// the store links open the listings.
const apps = [
	{
		name: 'OpenGiving',
		page: '/work/opengiving/',
		icon: '/assets/app-icon-opengiving.jpg',
		about: 'Sellers route part of each sale to a fundraising campaign.',
		stores: [
			{ label: 'App Store', href: 'https://apps.apple.com/us/app/opengiving-donate-shop/id6756851957' },
			{ label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=me.opengiving.android' },
		],
	},
	{
		name: 'Trophy Rooms',
		page: '/work/trophy-rooms/',
		icon: '/assets/app-icon-trophy-rooms.jpg',
		about: 'Tracks game collections across 42 platforms.',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/trophy-rooms/id6799829599' }],
	},
	{
		name: 'PacBag',
		page: '/work/pacbag/',
		icon: '/assets/app-icon-pacbag.jpg',
		about: 'Tracks what’s in each bag and weighs it against the airline limit.',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/pacbag-digital-luggage/id6749021887' }],
	},
	{
		name: 'ZeroPunch',
		page: '/work/zeropunch/',
		icon: '/assets/app-icon-zeropunch.jpg',
		about: 'A field app for construction crews, built at',
		mark: 'daero',
		stores: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/id6753096907' }],
	},
];
---

<BaseLayout>
	<div class="wrapper stack gap-16 lg:gap-24">
		<header class="intro">
			<div class="intro-text">
				<BuildLine />
				<p class="lede">
					The biggest thing I’ve built is <OpenGivingLogo />, a
					marketplace where part of every sale goes to a fundraising campaign. I wrote all
					the code for it: web, iOS and Android apps, and the backend API they share.
				</p>
				<p>
					I grew up in <span class="nowrap">São Paulo <Flag country="br" label="Brazil" /></span>. Currently, I am studying at Brown
					University until May 2027, pursuing an MS in Entrepreneurship, and studying
					cybersecurity at Harvard University (cross-registered in person). Before Brown I
					was the first engineering hire at <DaeroLogo />, a construction software startup
					in Boston backed by <NfxLogo />. I spent ten months leading their iOS app dev,
					while also supporting the web, infra and backend work.
				</p>
				<p>
					I got my B.Sc. in Computer Engineering at Insper. For my
					<a href="/work/pinpag-capstone/">capstone</a>, I worked on multi-cloud security
					monitoring for <PinPagLogo />, a Brazilian payments company. Part of it was a Python tool that mapped how their AWS
					resources connected and flagged anything open to the internet that shouldn’t be.
					I was also on a team of four building rescue robots, for 2 years. We won
					a Best in Class award for sensing at <RoboCupLogo /> in
					<span class="nowrap">2022 <Flag country="th" label="Bangkok, Thailand" /></span>,
					and mapping and autonomous navigation in
					<span class="nowrap">2023 <Flag country="fr" label="Bordeaux, France" /></span>.
					In 2023 I also became president of the university’s robotics club.
				</p>
				<p class="contact">
					Email’s the easiest way to reach me:
					<a href="mailto:me@enriccogemha.dev">me@enriccogemha.dev</a>
				</p>
			</div>
			<img
				src="/assets/demoing-opengiving.jpg"
				alt="Enricco Gemha, in an OpenGiving T-shirt and a Behring Founders lanyard, demoing OpenGiving on his phone."
				width="630"
				height="1110"
				decoding="async"
				fetchpriority="high"
			/>
		</header>

		<section class="stack gap-4" aria-labelledby="shipped-heading">
			<h2 class="section-label" id="shipped-heading">Things you can install</h2>
			<ul class="apps">
				{
					apps.map((app) => (
						<li>
							<img class="app-icon" src={app.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
							<div class="app-text">
								<a class="app-name" href={app.page}>{app.name}</a>
								<span class="app-about">{app.about}{app.mark === 'daero' && <> <DaeroLogo />.</>}</span>
							</div>
							<ul class="stores">
								{app.stores.map((store) => (
									<li>
										<a href={store.href} rel="noopener">{store.label}<span class="sr-only">: {app.name}</span></a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack gap-4" aria-labelledby="certifications-heading">
			<h2 class="section-label" id="certifications-heading">Certifications</h2>
			<Certifications />
		</section>

		<section class="stack" aria-labelledby="work-heading">
			<h2 class="section-label" id="work-heading">Work</h2>
			{featured.map((project) => <ProjectEntry project={project} />)}
		</section>

		<section class="stack gap-4" aria-labelledby="more-heading">
			<h2 class="section-label" id="more-heading">Earlier</h2>
			<ul class="compact">
				{
					rest.map((project) => (
						<li>
							<a href={`/work/${project.id}/`}>{project.data.logo === 'robocup' && <><RoboCupLogo linked={false} decorative />{' '}</>}{project.data.logo === 'pinpag' && <><PinPagLogo linked={false} decorative />{' '}</>}{project.data.logo === 'lua' && <><LuaLogo linked={false} decorative />{' '}</>}{project.data.title}</a>
							<span class="compact-summary">{project.data.summary}</span>
							<span class="compact-meta">
								<span>{project.data.period}</span>
								<Status status={project.data.status} />
							</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.intro {
		display: grid;
		gap: 2rem;
	}

	.intro-text {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: var(--measure);
	}

	.intro-text :global(.build-line) {
		margin-bottom: 0.4rem;
	}

	.contact {
		font-size: var(--text-base);
		margin-top: 0.4rem;
	}

	/* On narrow screens the photo sits above the greeting at avatar size,
	   so the first thing on the page is still a face and a name. */
	.intro img {
		order: -1;
		width: 7.5rem;
		border: 1px solid var(--rule);
	}

	@media (min-width: 48em) {
		.intro {
			grid-template-columns: minmax(0, 1fr) 13rem;
			gap: 3.5rem;
			align-items: start;
		}

		.intro img {
			order: 0;
			width: 100%;
			margin-top: 0.75rem;
		}
	}

	/* One row per app, divided like the Earlier list below it. On wide screens
	   the store links sit at the end of the row; on narrow ones they drop under
	   the description. */
	.apps {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.apps > li {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		align-items: start;
		gap: 0.35rem 1rem;
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
	}

	/* OpenGiving's artwork has its own rounded corners with white outside
	   them, starting 31% in from each corner. Masking every icon at 31%
	   hides that white and gives the three the same shape. */
	.app-icon {
		grid-row: span 2;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--rule);
		border-radius: 31%;
	}

	.app-text {
		display: grid;
		gap: 0.1rem;
	}

	.app-name {
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.app-name:hover {
		color: var(--accent);
	}

	.app-about {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.stores {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}

	@media (min-width: 42em) {
		.apps > li {
			grid-template-columns: 2.75rem minmax(0, 1fr) auto;
			align-items: center;
		}

		.app-icon {
			grid-row: auto;
		}

		.stores {
			justify-content: flex-end;
		}
	}

	.compact {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.compact li {
		display: grid;
		gap: 0.15rem 1rem;
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
	}

	.compact-summary {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.compact-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	@media (min-width: 42em) {
		.compact li {
			grid-template-columns: 12rem 1fr auto;
			align-items: baseline;
		}

		.compact-meta {
			justify-content: flex-end;
		}
	}
</style>
