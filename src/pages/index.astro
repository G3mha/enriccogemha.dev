---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Status from '../components/Status.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

const shipped = [
	{
		label: 'OpenGiving',
		note: 'iOS',
		href: 'https://apps.apple.com/us/app/opengiving-donate-shop/id6756851957',
	},
	{
		label: 'OpenGiving',
		note: 'Android',
		href: 'https://play.google.com/store/apps/details?id=me.opengiving.android',
	},
	{
		label: 'PacBag',
		note: 'iOS',
		href: 'https://apps.apple.com/us/app/pacbag-digital-luggage/id6749021887',
	},
	{
		label: 'ZeroPunch',
		note: 'iOS, at DAERO',
		href: 'https://apps.apple.com/us/app/id6753096907',
	},
];
---

<BaseLayout>
	<div class="wrapper stack gap-16 lg:gap-24">
		<header class="intro stack gap-6">
			<h1>Enricco Gemha</h1>
			<p class="lede">
				I build iOS apps and the backends behind them. Right now that mostly means
				OpenGiving, a marketplace running as a web app, an iOS app and an Android app
				on one API that I write all of.
			</p>
			<p class="facts">
				M.S. Innovation Management &amp; Entrepreneurship at Brown, May 2027. Before
				that, first engineering hire at <a href="https://apps.apple.com/us/app/id6753096907" rel="noopener">DAERO Group</a>
				in Boston, and a B.S. in Computer Engineering at Insper in São Paulo.
				Providence, Rhode Island.
			</p>
			<p class="facts">
				<a href="https://github.com/G3mha" rel="me noopener">GitHub</a> ·
				<a href="https://www.linkedin.com/in/enriccogemha" rel="me noopener">LinkedIn</a> ·
				<a href="mailto:me@enriccogemha.dev">me@enriccogemha.dev</a>
			</p>
		</header>

		<section class="stack gap-4" aria-labelledby="shipped-heading">
			<h2 class="section-label" id="shipped-heading">Things you can install</h2>
			<ul class="shipped">
				{
					shipped.map((item) => (
						<li>
							<a href={item.href} rel="noopener">
								{item.label}
							</a>
							<span>{item.note}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack" aria-labelledby="work-heading">
			<h2 class="section-label" id="work-heading">Work</h2>
			{featured.map((project) => <ProjectEntry project={project} />)}
		</section>

		<section class="stack gap-4" aria-labelledby="more-heading">
			<h2 class="section-label" id="more-heading">Earlier</h2>
			<ul class="compact">
				{
					rest.map((project) => (
						<li>
							<a href={`/work/${project.id}/`}>{project.data.title}</a>
							<span class="compact-summary">{project.data.summary}</span>
							<span class="compact-meta">
								<span>{project.data.period}</span>
								<Status status={project.data.status} />
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="stack gap-4 closing" aria-labelledby="now-heading">
			<h2 class="section-label" id="now-heading">Now</h2>
			<p>
				I am at Brown until May 2027, working on OpenGiving most days and reading my
				way further into systems security, which is the elective I am taking at
				Harvard this term. If you want to talk about any of the above, or about
				something you are building, write to me.
			</p>
			<p>
				<a href="mailto:me@enriccogemha.dev">me@enriccogemha.dev</a>
			</p>
		</section>
	</div>
</BaseLayout>

<style>
	.intro {
		max-width: var(--measure);
	}

	.lede {
		font-size: var(--text-lg);
		color: var(--ink);
	}

	.facts {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.shipped {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shipped li {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.shipped span {
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.compact {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.compact li {
		display: grid;
		gap: 0.15rem 1rem;
		padding-block: 0.9rem;
		border-top: 1px solid var(--rule);
	}

	.compact-summary {
		font-size: var(--text-base);
		color: var(--ink-tertiary);
	}

	.compact-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		font-size: var(--text-sm);
		color: var(--ink-tertiary);
	}

	.closing {
		max-width: var(--measure);
	}

	@media (min-width: 42em) {
		.compact li {
			grid-template-columns: 12rem 1fr auto;
			align-items: baseline;
		}

		.compact-meta {
			justify-content: flex-end;
		}
	}
</style>
