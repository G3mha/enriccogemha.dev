---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Status from '../../components/Status.astro';
import Tags from '../../components/Tags.astro';
import RoboCupLogo from '../../components/RoboCupLogo.astro';
import MarkedText from '../../components/MarkedText.astro';

export async function getStaticPaths() {
	const projects = await getCollection('work');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<BaseLayout title={`${data.title} | Enricco Gemha`} description={data.summary}>
	<div class="wrapper wrapper-narrow stack gap-10">
		<p class="back"><a href="/">Back to work</a></p>

		<header class="stack gap-4">
			{data.logo === 'robocup' && <div class="project-logo"><RoboCupLogo size="large" /></div>}
			<div class="head">
				<h1>{data.title}</h1>
				<Status status={data.status} />
			</div>
			<p class="summary"><MarkedText text={data.summary} logo={data.logo} /></p>
			<dl class="meta">
				<div>
					<dt>When</dt>
					<dd>{data.period}</dd>
				</div>
				<div>
					<dt>My part</dt>
					<dd>{data.role}</dd>
				</div>
			</dl>
			<Tags items={data.stack} />
			{
				data.links.length > 0 && (
					<ul class="links">
						{data.links.map((link) => (
							<li>
								<a href={link.href} rel="noopener">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			data.img && (
				<img
					src={data.img}
					alt={data.img_alt ?? ''}
					loading="lazy"
					decoding="async"
					width="1600"
					height="900"
				/>
			)
		}

		<div class="prose">
			<Content />
		</div>
	</div>
</BaseLayout>

<style>
	.project-logo {
		margin-bottom: 0.5rem;
	}

	.back {
		font-size: var(--text-base);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
	}

	.summary {
		font-size: var(--text-lg);
		color: var(--ink);
		max-width: var(--measure);
	}

	.meta {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding-block: 1rem;
		border-block: 1px solid var(--rule);
		font-size: var(--text-base);
	}

	.meta div {
		display: grid;
		gap: 0.15rem;
	}

	dt {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-tertiary);
	}

	dd {
		margin: 0;
		color: var(--ink);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-base);
	}

	img {
		border: 1px solid var(--rule);
		object-fit: cover;
	}

	@media (min-width: 42em) {
		.meta {
			grid-template-columns: 1fr 2fr;
			gap: 1.5rem;
		}
	}
</style>
